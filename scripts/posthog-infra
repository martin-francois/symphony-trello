#!/bin/bash
# Entry point for the PostHog infrastructure under infra/posthog: OpenTofu plus the few API-owned
# operations the official provider cannot express. Every command that reaches PostHog reads the
# personal API key from a file and hands it to the child process only; nothing prints it.
#
# See docs/posthog-infrastructure.md for the workflow this script implements.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
INFRA_DIR="$ROOT/infra/posthog"
SUPPLEMENT="$ROOT/scripts/posthog-infra.ts"
KEY_FILE="${SYMPHONY_TRELLO_POSTHOG_KEY_FILE:-$HOME/posthog-personal-api-key}"
STATE_DIR="${SYMPHONY_TRELLO_POSTHOG_STATE_DIR:-$HOME/.local/state/symphony-trello/posthog}"
HOST="${SYMPHONY_TRELLO_POSTHOG_HOST:-https://eu.posthog.com}"
STATE_FILE="$STATE_DIR/terraform.tfstate"
OUTPUTS_FILE="$STATE_DIR/outputs.json"
# OpenTofu keeps the initialized backend in its data directory. Keeping that directory inside the
# selected state directory binds every command to that deployment; a shared .terraform under the
# configuration would keep pointing at whichever state was initialized first.
DATA_DIR="${TF_DATA_DIR:-$STATE_DIR/.terraform}"
BACKEND_RECORD="$DATA_DIR/terraform.tfstate"
ROLES=(production test)

usage() {
  cat <<'USAGE'
Usage: scripts/posthog-infra <command> [options]

Offline (no credentials):
  fmt [-check]          Format the configuration, or check it in CI.
  validate              Initialize without a backend and validate the configuration.

With the personal API key (read from SYMPHONY_TRELLO_POSTHOG_KEY_FILE, default ~/posthog-personal-api-key):
  init                  Initialize with the private state path (SYMPHONY_TRELLO_POSTHOG_STATE_DIR).
  plan                  Plan with -detailed-exitcode (0 no changes, 2 changes, 1 error).
  apply [-auto-approve] Bootstrap projects and adopt each project's GeoIP transformation when the
                        state lacks it, apply the full configuration, apply the API supplements,
                        then verify.
  gaps <diff|apply>     Only the API-owned settings outside the plan (diff exits 2 when changes are needed).
  verify [report-path]  Read-only verification report (default: <state dir>/verification-report.md).
  fixture               Send the dashboard fixture to the test project and check every panel query.
  release-token <owner/repo>
                        Store the production capture token in that repository's POSTHOG_PROJECT_TOKEN secret.
  retire-project <id> "<name>"
                        Delete one project that is not managed by this state, after checking its name.
  destroy [-auto-approve]
                        Destroy everything in the state.
  tofu <args...>        Run any OpenTofu command against the selected state with credentials set.
  state-path            Print the state file the selected data directory is bound to.

Each state directory (SYMPHONY_TRELLO_POSTHOG_STATE_DIR) holds its own OpenTofu data directory, so
switching the variable switches the whole deployment; commands refuse to run against a data
directory bound to another state file.
USAGE
}

require_key_file() {
  if [[ ! -r "$KEY_FILE" ]]; then
    echo "posthog-infra: personal API key file not readable: $KEY_FILE" >&2
    echo "  Create it with the key (see docs/posthog-infrastructure.md) or set SYMPHONY_TRELLO_POSTHOG_KEY_FILE." >&2
    exit 2
  fi
}

# The key exists only in the environment of the child processes this function starts.
with_credentials() {
  require_key_file
  local key
  key="$(tr -d '[:space:]' <"$KEY_FILE")"
  if [[ "$key" != phx_* ]]; then
    echo "posthog-infra: $KEY_FILE does not hold a personal API key (expected a phx_ prefix)" >&2
    exit 2
  fi
  POSTHOG_API_KEY="$key" POSTHOG_HOST="$HOST" "$@"
}

tofu_cmd() {
  TF_DATA_DIR="$DATA_DIR" with_credentials tofu -chdir="$INFRA_DIR" "$@"
}

# The backend path OpenTofu recorded at init, or empty when this data directory was never
# initialized. The check reads the record itself instead of trusting that a directory exists.
bound_state_path() {
  if [[ ! -f "$BACKEND_RECORD" ]]; then
    return
  fi
  node -e '
    const record = JSON.parse(require("fs").readFileSync(process.argv[1], "utf8"));
    process.stdout.write(String((record.backend && record.backend.config && record.backend.config.path) || ""));
  ' "$BACKEND_RECORD"
}

# Every command that reads or changes state runs only when the data directory is bound to the
# selected state file; a mismatch names both paths and stops before any request.
require_bound_state() {
  local bound
  bound="$(bound_state_path)"
  if [[ "$bound" != "$STATE_FILE" ]]; then
    echo "posthog-infra: data directory $DATA_DIR is bound to ${bound:-no state}, not to $STATE_FILE" >&2
    echo "  Run scripts/posthog-infra init with the same SYMPHONY_TRELLO_POSTHOG_STATE_DIR first." >&2
    exit 2
  fi
}

supplement() {
  with_credentials node "$SUPPLEMENT" "$@" --host "$HOST"
}

ensure_state_dir() {
  mkdir -p "$STATE_DIR"
  chmod 700 "$STATE_DIR"
}

cmd_init() {
  ensure_state_dir
  tofu_cmd init -input=false -backend-config="path=$STATE_FILE" "$@"
  require_bound_state
}

require_initialized() {
  if [[ -z "$(bound_state_path)" ]]; then
    cmd_init
  fi
  require_bound_state
}

write_outputs() {
  ensure_state_dir
  (umask 077 && tofu_cmd output -json >"$OUTPUTS_FILE")
}

state_has() {
  tofu_cmd state list 2>/dev/null | grep -qx "$1"
}

# PostHog creates an enabled GeoIP transformation with every project; the configuration declares it
# disabled. Before the first full apply the projects are created alone, each project's server-made
# function is looked up by scope and imported, and only then does the full apply run, so no second
# GeoIP function is ever created.
bootstrap() {
  local role targets=() missing=()
  local apply_args=("$@")
  for role in "${ROLES[@]}"; do
    if ! state_has "module.$role.posthog_hog_function.geoip"; then
      missing+=("$role")
      targets+=("-target=module.$role.posthog_project.this")
    fi
  done
  if [[ ${#missing[@]} -eq 0 ]]; then
    return
  fi
  echo "posthog-infra: bootstrap for roles: ${missing[*]}"
  tofu_cmd apply -input=false -auto-approve "${targets[@]}" "${apply_args[@]}"
  for role in "${missing[@]}"; do
    local project_id function_id
    project_id="$(project_id_from_state "$role")"
    function_id="$(supplement geoip-id --project "$project_id")"
    tofu_cmd import -input=false "module.$role.posthog_hog_function.geoip" "$project_id/$function_id"
  done
}

# The project id straight from the state; outputs are not complete until the full apply.
project_id_from_state() {
  tofu_cmd show -json | node -e '
    const show = JSON.parse(require("fs").readFileSync(0, "utf8"));
    const address = "module." + process.argv[1] + ".posthog_project.this";
    const modules = show.values?.root_module?.child_modules ?? [];
    const resource = modules.flatMap((module) => module.resources ?? []).find((entry) => entry.address === address);
    if (!resource) { console.error("no " + address + " in state"); process.exit(1); }
    console.log(resource.values.id);
  ' "$1"
}

cmd_apply() {
  require_initialized
  reject_partial_apply_args "$@"
  bootstrap "${@//-auto-approve/}"
  tofu_cmd apply -input=false "$@"
  write_outputs
  supplement gaps apply --outputs "$OUTPUTS_FILE"
  cmd_verify
}

# Inputs must reach every phase (bootstrap, import, full apply, supplements); only these three
# options are known to, so anything else is refused before the bootstrap can mutate.
reject_partial_apply_args() {
  local argument
  for argument in "$@"; do
    case "$argument" in
    -auto-approve | -var-file=* | -no-color) ;;
    *)
      echo "posthog-infra: apply accepts only -auto-approve, -var-file=<file>, and -no-color; got $argument" >&2
      exit 2
      ;;
    esac
  done
}

cmd_verify() {
  require_initialized
  write_outputs
  local report="${1:-$STATE_DIR/verification-report.md}"
  supplement verify --outputs "$OUTPUTS_FILE" --report "$report" --config-revision "$(config_revision)" \
    --tofu-version "$(tofu version -json | node -e 'process.stdout.write(JSON.parse(require("fs").readFileSync(0,"utf8")).terraform_version)')" \
    --provider-version "$(grep -A1 'registry.opentofu.org/posthog/posthog' "$INFRA_DIR/.terraform.lock.hcl" | sed -n 's/.*version *= *"\([^"]*\)".*/\1/p')"
  echo "posthog-infra: report written to $report"
}

config_revision() {
  local sha dirty=""
  sha="$(git -C "$ROOT" rev-parse --short HEAD 2>/dev/null || echo unknown)"
  if [[ -n "$(git -C "$ROOT" status --porcelain -- infra/posthog scripts/posthog-infra scripts/posthog-infra.ts 2>/dev/null)" ]]; then
    dirty=" (uncommitted changes in infra/posthog or scripts/posthog-infra)"
  fi
  echo "$sha$dirty"
}

cmd_release_token() {
  local repository="${1:-}"
  if [[ ! "$repository" =~ ^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$ ]]; then
    echo "posthog-infra: release-token needs the destination repository as owner/name" >&2
    exit 2
  fi
  require_initialized
  write_outputs
  echo "posthog-infra: production token from state $STATE_FILE (project $(node -e 'const o=require(process.argv[1]); console.log(o.projects.value.production.id)' "$OUTPUTS_FILE"))"
  # The token travels from the outputs file into gh's stdin; it never becomes an argument.
  node -e 'const o=require(process.argv[1]); process.stdout.write(o.capture_tokens.value.production)' "$OUTPUTS_FILE" |
    gh secret set POSTHOG_PROJECT_TOKEN --repo "$repository"
  echo "posthog-infra: POSTHOG_PROJECT_TOKEN updated in $repository (GitHub reports the name and time only):"
  gh secret list --repo "$repository" | grep '^POSTHOG_PROJECT_TOKEN'
}

command="${1:-}"
shift || true
case "$command" in
fmt) tofu -chdir="$INFRA_DIR" fmt -recursive "$@" ;;
validate)
  # A separate data directory keeps the backend-less init from disturbing the credentialed one.
  TF_DATA_DIR="$INFRA_DIR/.terraform-validate" tofu -chdir="$INFRA_DIR" init -input=false -backend=false >/dev/null
  TF_DATA_DIR="$INFRA_DIR/.terraform-validate" tofu -chdir="$INFRA_DIR" validate "$@"
  ;;
init) cmd_init "$@" ;;
plan)
  require_initialized
  tofu_cmd plan -input=false -detailed-exitcode "$@"
  ;;
apply) cmd_apply "$@" ;;
gaps)
  require_initialized
  write_outputs
  supplement gaps "${1:?diff or apply}" --outputs "$OUTPUTS_FILE"
  ;;
verify) cmd_verify "$@" ;;
fixture)
  require_initialized
  write_outputs
  supplement fixture --outputs "$OUTPUTS_FILE" --role test --run-file "$STATE_DIR/fixture-$(date -u +%Y%m%dT%H%M%SZ).json"
  ;;
release-token) cmd_release_token "$@" ;;
retire-project)
  # A project this state manages is retired through destroy, never through this command.
  if [[ -n "$(bound_state_path)" ]] && tofu_cmd state list 2>/dev/null | grep -q '^module\.'; then
    write_outputs
    if node -e 'const o=require(process.argv[1]); process.exit(Object.values(o.projects.value).some((p) => String(p.id) === process.argv[2]) ? 0 : 1)' "$OUTPUTS_FILE" "${1:?project id}"; then
      echo "posthog-infra: project $1 is managed by $STATE_FILE; use destroy instead of retire-project" >&2
      exit 2
    fi
  fi
  supplement retire-project --id "${1:?project id}" --name "${2:?expected name}"
  ;;
destroy)
  require_initialized
  echo "posthog-infra: destroying everything in $STATE_FILE"
  tofu_cmd destroy -input=false "$@"
  rm -f "$OUTPUTS_FILE"
  ;;
tofu)
  # Any OpenTofu command against the selected, bound state; the same guard applies.
  require_initialized
  tofu_cmd "$@"
  ;;
state-path)
  # Which state file the selected data directory is bound to (empty when not initialized).
  bound_state_path
  echo
  ;;
-h | --help | help | "") usage ;;
*)
  echo "posthog-infra: unknown command $command" >&2
  usage >&2
  exit 2
  ;;
esac
