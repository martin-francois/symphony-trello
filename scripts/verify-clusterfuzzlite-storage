#!/bin/bash
set -euo pipefail

storage_repository="${CFL_STORAGE_REPOSITORY:?CFL_STORAGE_REPOSITORY is required}"
script_directory="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
coverage_verifier="$script_directory/verify-clusterfuzzlite-coverage"
mode="${1:-}"
shift || true

verify_path() {
  local branch="$1"
  local path="$2"

  if ! gh api --method GET \
    -H "Accept: application/vnd.github+json" \
    "repos/$storage_repository/contents/$path" \
    -f "ref=$branch" \
    >/dev/null; then
    echo "ClusterFuzzLite did not persist $path on $storage_repository:$branch" >&2
    return 1
  fi
}

case "$mode" in
corpus)
  if (($# == 0)); then
    echo "At least one fuzz target is required for corpus verification." >&2
    exit 2
  fi
  for target in "$@"; do
    verify_path main "corpus/$target"
  done
  ;;
coverage)
  if (($# != 0)); then
    echo "Coverage verification does not accept fuzz targets." >&2
    exit 2
  fi
  coverage_root=coverage/latest
  while IFS= read -r required_file; do
    verify_path gh-pages "$coverage_root/$required_file"
  done < <("$coverage_verifier" list-required-files)

  reports_directory="$(mktemp -d "${TMPDIR:-/tmp}/clusterfuzzlite-coverage-reports.XXXXXX")"
  trap 'rm -rf -- "$reports_directory"' EXIT
  while IFS= read -r report_file; do
    mkdir -p -- "$reports_directory/$(dirname -- "$report_file")"
    gh api --method GET \
      -H "Accept: application/vnd.github+json" \
      "repos/$storage_repository/contents/$coverage_root/$report_file" \
      -f ref=gh-pages \
      --jq .content |
      tr -d '\n' |
      base64 --decode \
        >"$reports_directory/$report_file"
  done < <("$coverage_verifier" list-json-files)
  "$coverage_verifier" verify-json-directory "$reports_directory"
  ;;
*)
  echo "Usage: $0 corpus <target>... | coverage" >&2
  exit 2
  ;;
esac
