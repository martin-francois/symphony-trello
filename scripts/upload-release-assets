#!/bin/bash

set -euo pipefail

release_asset_list="$(scripts/list-release-assets "$RELEASE_VERSION")"
mapfile -t expected_assets <<<"$release_asset_list"
existing_assets="$(gh release view --repo "$GITHUB_REPOSITORY" "$RELEASE_TAG" --json assets --jq '.assets[].name')"
upload_assets=()
for asset in "${expected_assets[@]}"; do
  path="$ASSET_DIR/$asset"
  if [[ ! -f "$path" ]]; then
    echo "release asset was not built: $asset" >&2
    exit 2
  fi
  if grep -Fx -- "$asset" <<<"$existing_assets" >/dev/null; then
    continue
  fi
  upload_assets+=("$path")
done
if ((${#upload_assets[@]} == 0)); then
  echo "release already contains every expected public asset; refusing same-tag asset reuse" >&2
  exit 2
fi
gh release upload --repo "$GITHUB_REPOSITORY" "$RELEASE_TAG" "${upload_assets[@]}"
