#!/bin/bash
# Compares the BetterLeaks image pinned on the base branch with the pull request's and
# writes head_image and changed to GITHUB_OUTPUT for the pinned-betterleaks-image job in
# .github/workflows/private-context.yml.
#
# Usage: scripts/compare-betterleaks-images BASE_WRAPPER HEAD_WRAPPER, each a betterleaks-docker.sh.

set -euo pipefail

# Read the image the wrapper runs, not any reference in the file: exactly one image
# assignment, a digest-pinned image from the publisher's repository, passed to exec.
# A pull request can pick a released BetterLeaks image but never an image of its own.
effective_image() {
  local assignments
  assignments="$(grep -cE '(^|[^[:alnum:]_])image\+?=' "$1" || true)"
  # shellcheck disable=SC2016 # the exec line is matched literally
  if [ "$assignments" -eq 1 ] &&
    grep -qxF 'exec "$container_runtime" "${docker_args[@]}" "$image" "$@"' "$1"; then
    local ref='ghcr\.io/betterleaks/betterleaks:v[0-9]+\.[0-9]+\.[0-9]+@sha256:[0-9a-f]{64}'
    sed -nE -e "s#^image=\"\\\$\\{SYMPHONY_TRELLO_BETTERLEAKS_IMAGE:-($ref)\\}\"\$#\\1#p" \
      -e "s#^image=\"($ref)\"\$#\\1#p" "$1"
  fi
}
base_image="$(effective_image "$1")"
head_image="$(effective_image "$2")"
for side in base head; do
  image_var="${side}_image"
  if [ -z "${!image_var}" ]; then
    echo "::error file=scripts/betterleaks-docker.sh::Cannot tell which image the $side branch runs. Keep one image=\"\${SYMPHONY_TRELLO_BETTERLEAKS_IMAGE:-ghcr.io/betterleaks/betterleaks:vX.Y.Z@sha256:...}\" line and pass \"\$image\" to exec."
    exit 1
  fi
done
echo "head_image=$head_image" >>"$GITHUB_OUTPUT"
if [ "$head_image" = "$base_image" ]; then
  echo "changed=false" >>"$GITHUB_OUTPUT"
  echo "::notice::The pull request keeps the base branch's BetterLeaks image; the private-context job already scans with it."
else
  echo "changed=true" >>"$GITHUB_OUTPUT"
  echo "::notice::Scanning with $head_image, which replaces $base_image."
fi
