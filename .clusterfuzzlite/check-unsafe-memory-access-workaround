# Expiry check for the --sun-misc-unsafe-memory-access=allow workaround in oss-fuzz/build.sh
# (issue #913). Runs one generated fuzzer once with the JDK warning turned back on and fails once
# the Jazzer runtime from the OSS-Fuzz base image no longer triggers it.

set -euo pipefail

readonly unsafe_warning='WARNING: A terminally deprecated method in sun.misc.Unsafe has been called'

shopt -s nullglob
fuzzers=("$OUT"/*Fuzzer)
shopt -u nullglob
if ((${#fuzzers[@]} == 0)); then
  echo "No generated fuzzers found in $OUT" >&2
  exit 1
fi

run_dir="$(mktemp -d)"
log="$run_dir/fuzzer.log"
if ! (cd "$run_dir" && SYMPHONY_TRELLO_FUZZ_UNSAFE_MEMORY_ACCESS=warn "${fuzzers[0]}" -runs=1 >"$log" 2>&1); then
  cat "$log" >&2
  echo "Running ${fuzzers[0]} once failed; cannot check the sun.misc.Unsafe workaround." >&2
  exit 1
fi

if grep -qF "$unsafe_warning" "$log"; then
  echo "Jazzer still calls sun.misc.Unsafe memory-access methods; keeping the workaround (#913)."
  exit 0
fi

cat "$log" >&2
cat >&2 <<'MESSAGE'
The Jazzer runtime no longer triggers the sun.misc.Unsafe warning. Remove the
--sun-misc-unsafe-memory-access workaround as described in issue #913.
MESSAGE
exit 1
