{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    ":rebaseStalePrs"
  ],
  "reviewers": [
    "martinfrancois"
  ],
  "labels": [
    "dependencies"
  ],
  "rangeStrategy": "pin",
  "pinDigests": true,
  "prConcurrentLimit": 0,
  "branchConcurrentLimit": 0,
  "minimumReleaseAge": "7 days",
  "minimumReleaseAgeBehaviour": "timestamp-required",
  "internalChecksFilter": "strict",
  "statusCheckWhen": {
    "minimumReleaseAge": "never"
  },
  "automerge": true,
  "dependencyDashboardApproval": false,
  "separateMajorMinor": true,
  "separateMultipleMajor": true,
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": [
      "security"
    ]
  },
  "lockFileMaintenance": {
    "description": "Refresh the committed lockfiles on a schedule so transitive advisories get fixed. Renovate only proposes updates for the direct declarations it manages, so a vulnerable package that no manifest names is never reached by an ordinary update or by a vulnerability alert, and its advisory stays open until the lockfile is regenerated. The Friday early-morning window matches the maintainer's preference for scheduled dependency work, and automerge matches the non-major automerge policy: required status checks still gate the merge, so a refresh that breaks a check stays open for review.",
    "enabled": true,
    "schedule": [
      "* 0-4 * * 5"
    ],
    "automerge": true
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^tessl\\.json$/"
      ],
      "matchStrings": [
        "\"(?<depName>tessl-labs/good-oss-citizen)\"\\s*:\\s*\\{\\s*\"version\"\\s*:\\s*\"(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "custom.tessl-tile",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/ci\\.yml$/",
        "/^\\.github/workflows/commitlint\\.yml$/"
      ],
      "matchStrings": [
        "corepack prepare pnpm@(?<currentValue>\\d+\\.\\d+\\.\\d+) --activate"
      ],
      "datasourceTemplate": "npm",
      "depNameTemplate": "pnpm",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/ci\\.yml$/",
        "/^scripts/dependency-governance\\.test\\.ts$/"
      ],
      "matchStrings": [
        "--package\\s+renovate@(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "datasourceTemplate": "npm",
      "depNameTemplate": "renovate",
      "versioningTemplate": "semver",
      "description": "Keep the pinned Renovate config validator and its regression expectation in lockstep so CI never resolves a moving toolchain."
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/commitlint\\.yml$/",
        "/^scripts/commitlint-local$/"
      ],
      "matchStrings": [
        "(?:--package\\s+|\\s+)(?<depName>@commitlint/(?:cli|config-conventional))@(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "datasourceTemplate": "npm",
      "versioningTemplate": "semver",
      "description": "The commitlint versions pinned inline in the commitlint workflow and in scripts/commitlint-local. No built-in manager reads a version out of a shell script or a workflow run step, and the two must move together or a local check disagrees with CI."
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/ci\\.yml$/",
        "/^scripts/pwsh-docker\\.sh$/"
      ],
      "matchStrings": [
        "(?<depName>mcr\\.microsoft\\.com/dotnet/sdk):(?<currentValue>\\d+\\.\\d+)@(?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^scripts/semgrep-docker\\.sh$/"
      ],
      "matchStrings": [
        "docker\\.io/(?<depName>semgrep/semgrep):(?<currentValue>\\d+\\.\\d+\\.\\d+)@(?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^scripts/betterleaks-docker\\.sh$/"
      ],
      "matchStrings": [
        "(?<depName>ghcr\\.io/betterleaks/betterleaks):v(?<currentValue>\\d+\\.\\d+\\.\\d+)@(?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    }
  ],
  "customDatasources": {
    "tessl-tile": {
      "defaultRegistryUrlTemplate": "https://api.tessl.io/v1/tiles/{{packageName}}",
      "transformTemplates": [
        "{\"releases\":[{\"version\": data.attributes.latestVersion, \"releaseTimestamp\": data.attributes.latestVersionData.attributes.createdAt}], \"homepage\":\"https://tessl.io/registry/\" & data.attributes.fullName}"
      ]
    }
  },
  "packageRules": [
    {
      "description": "Public repository: merge eligible non-major updates after checks pass. Group only dependencies that need coordinated updates; keep unrelated updates separate.",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "pinDigest",
        "digest"
      ],
      "automerge": true
    },
    {
      "matchDatasources": [
        "maven"
      ],
      "matchPackageNames": [
        "com.google.errorprone:error_prone_core",
        "org.openrewrite:*",
        "org.openrewrite.maven:*",
        "org.openrewrite.recipe:*",
        "tech.picnic.error-prone-support:error-prone-contrib",
        "tech.picnic.error-prone-support:refaster-runner"
      ],
      "groupName": "OpenRewrite toolchain",
      "branchTopic": "openrewrite-toolchain",
      "rebaseWhen": "behind-base-branch",
      "automerge": true,
      "platformAutomerge": false,
      "addLabels": [
        "openrewrite"
      ],
      "prBodyNotes": [
        "Automation validates this dependency-only update and runs the ordered OpenRewrite and Spotless pipeline.",
        "When an eligible non-major update produces no repository change, required CI passes and Renovate automerges this pull request.",
        "When the toolchain changes source or POM output, this pull request remains blocked and automation opens or refreshes a separate generated pull request for maintainer review.",
        "Major updates are created automatically and require manual merge through the repository-wide major-update guard."
      ]
    },
    {
      "matchDatasources": [
        "maven"
      ],
      "matchPackageNames": [
        "io.quarkus:quarkus-update-recipes"
      ],
      "groupName": null,
      "automerge": false,
      "addLabels": [
        "quarkus"
      ],
      "prBodyNotes": [
        "Quarkus updater recipe changes MUST NOT be validated as general OpenRewrite maintenance updates.",
        "Before merge, a maintainer MUST review the target Quarkus migration guide, run `quarkus:update` in the dependency-update branch, review the complete diff, and pass the full Maven gate."
      ]
    },
    {
      "matchPackageNames": [
        "tessl-labs/good-oss-citizen"
      ],
      "groupName": null,
      "automerge": false,
      "addLabels": [
        "tessl"
      ],
      "prBodyNotes": [
        "After Renovate updates `tessl.json`, run `tessl install`, review the refreshed `.tessl/tiles` diff, and commit those vendored tile changes before merging."
      ]
    },
    {
      "description": "Major updates require human review of migration notes. Preserve compatibility groups whose members must move together across a major boundary.",
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false,
      "addLabels": [
        "major update"
      ]
    }
  ]
}
