{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    ":rebaseStalePrs",
    "group:all"
  ],
  "reviewers": ["martinfrancois"],
  "labels": ["dependencies"],
  "rangeStrategy": "replace",
  "minimumReleaseAge": "3 days",
  "minimumReleaseAgeBehaviour": "timestamp-required",
  "automerge": true,
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security"]
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^tessl\\.json$/"],
      "matchStrings": [
        "\"(?<depName>tessl-labs/good-oss-citizen)\"\\s*:\\s*\\{\\s*\"version\"\\s*:\\s*\"(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "custom.tessl-tile",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/ci\\.yml$/",
        "/^\\.github/workflows/commitlint\\.yml$/"
      ],
      "matchStrings": ["corepack prepare pnpm@(?<currentValue>\\d+\\.\\d+\\.\\d+) --activate"],
      "datasourceTemplate": "npm",
      "depNameTemplate": "pnpm",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/commitlint\\.yml$/",
        "/^AGENTS\\.md$/",
        "/^CONTRIBUTING\\.md$/",
        "/^scripts/commitlint-local$/"
      ],
      "matchStrings": [
        "(?:--package\\s+|\\s+)(?<depName>@commitlint/(?:cli|config-conventional))@(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "datasourceTemplate": "npm",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/ci\\.yml$/",
        "/^scripts/pwsh-docker\\.sh$/"
      ],
      "matchStrings": ["(?<depName>mcr\\.microsoft\\.com/dotnet/sdk):(?<currentValue>\\d+\\.\\d+)"],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^scripts/semgrep-docker\\.sh$/"
      ],
      "matchStrings": ["docker\\.io/(?<depName>semgrep/semgrep):(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^scripts/betterleaks-docker\\.sh$/"
      ],
      "matchStrings": ["(?<depName>ghcr\\.io/betterleaks/betterleaks):v(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^config/nil/Dockerfile$/"],
      "matchStrings": [
        "# renovate: NIL ref=(?<currentValue>\\S+)\\s+ARG NIL_COMMIT=(?<currentDigest>[a-f0-9]{40})"
      ],
      "datasourceTemplate": "git-refs",
      "depNameTemplate": "https://github.com/kusumotolab/NIL",
      "autoReplaceStringTemplate": "# renovate: NIL ref={{newValue}}\nARG NIL_COMMIT={{newDigest}}"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^config/nil/nil-jls25\\.patch$/"],
      "matchStrings": [
        "\\+\\s+implementation\\(\"org\\.eclipse\\.jdt:org\\.eclipse\\.jdt\\.core:(?<currentValue>\\d+\\.\\d+\\.\\d+)\"\\)"
      ],
      "datasourceTemplate": "maven",
      "depNameTemplate": "org.eclipse.jdt:org.eclipse.jdt.core",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^config/nil/nil-jls25\\.patch$/"],
      "matchStrings": [
        "id\\(\\\"com\\.gradleup\\.shadow\\\"\\) version \\\"(?<currentValue>\\d+\\.\\d+\\.\\d+)\\\""
      ],
      "datasourceTemplate": "maven",
      "depNameTemplate": "com.gradleup.shadow:com.gradleup.shadow.gradle.plugin",
      "registryUrlTemplate": "https://plugins.gradle.org/m2",
      "versioningTemplate": "semver"
    }
  ],
  "customDatasources": {
    "tessl-tile": {
      "defaultRegistryUrlTemplate": "https://api.tessl.io/v1/tiles/{{packageName}}",
      "transformTemplates": [
        "{\"releases\":[{\"version\": data.attributes.latestVersion, \"releaseTimestamp\": data.attributes.latestVersionData.attributes.createdAt}], \"homepage\":\"https://tessl.io/registry/\" & data.attributes.fullName}"
      ]
    }
  },
  "packageRules": [
    {
      "matchPackageNames": ["tessl-labs/good-oss-citizen"],
      "minimumReleaseAge": "7 days",
      "automerge": false,
      "dependencyDashboardApproval": true,
      "addLabels": ["tessl"],
      "prBodyNotes": [
        "After Renovate updates `tessl.json`, run `tessl install`, review the refreshed `.tessl/tiles` diff, and commit those vendored tile changes before merging."
      ]
    },
    {
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "dependencyDashboardApproval": true,
      "addLabels": ["major update"]
    }
  ]
}
