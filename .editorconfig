root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.java]
indent_size = 4

[src/test/snapshots/**]
# Snapshot baselines record command output exactly, including trailing spaces.
trim_trailing_whitespace = false
